# Postgres connection string. Added automatically when you connect a Neon database
# to the Vercel project (Storage tab). POSTGRES_URL is used as a fallback.
DATABASE_URL=

# Vercel Blob (private store) for task attachments. Added automatically when you
# connect a Blob store to the project. Client uploads need the read-write token.
BLOB_READ_WRITE_TOKEN=

# Super admin password for /admin (create managers, assign employees, see every team).
# Changing it signs every super admin session out.
ADMIN_PASSCODE=

# Optional. Secret used to sign sign-in cookies. Without it, a random secret is
# generated once and kept in the database (settings table), which is fine.
SESSION_SECRET=

# Optional. Earliest day team boards can log or edit (YYYY-MM-DD). Leave empty to
# allow today only. The Settings tab at /admin overrides it without a redeploy.
EDITABLE_FROM=
