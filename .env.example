# Postgres connection string. Added automatically when you connect a Neon database
# to the Vercel project (Storage tab). POSTGRES_URL is used as a fallback.
DATABASE_URL=

# Vercel Blob (private store) for task attachments. Added automatically when you
# connect a Blob store to the project. Client uploads need the read-write token.
BLOB_READ_WRITE_TOKEN=

# Passcode for the admin page at /rating. Required for ratings and locked days.
ADMIN_PASSCODE=

# Optional. Earliest day the team can log or edit without the admin passcode
# (YYYY-MM-DD). Leave empty to allow today only. A row in the `settings` table
# (key = 'editable_from') overrides this without a redeploy.
EDITABLE_FROM=
